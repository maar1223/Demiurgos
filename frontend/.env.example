# ============================================================
# Demiurgos — Frontend environment template (Vite)
# ============================================================
# Copy this file to frontend/.env and adjust. Vite only exposes
# variables prefixed with VITE_ to the browser bundle.

# Google Identity Services client ID (public — never a secret). Used by the
# vault login (DEMIURGOS_AUTH_MODE=google on the backend). It must match the
# server-side GOOGLE_CLIENT_ID, which verifies the issued id_token.
# VITE_GOOGLE_CLIENT_ID=

# Backend API base URL. Empty in development: Vite proxies /api to the
# backend (vite.config.ts server.proxy). Set it for a separate deployment.
# VITE_API_URL=