# ============================================================
# Configuración local con credenciales
# ============================================================
.env
.secrets/
*.json.credential
# Live idea-capture ingress policy (author's real Telegram ids). The tracked
# tree ships the sanitized config/idea-capture.yaml.example instead.
config/idea-capture.yaml

# ============================================================
# Mundos del Autor — contenido narrativo privado
# ============================================================
# Any new world is one `git add -A` away; the allow-list below is not enough.
mundos/*
mundos/Vibrantes-Legacy/
mundos/Ideas/
mundos/Vibrantes/
_archivo_produccion/

# ============================================================
# Estado local de Demiurgos (tracking de arcos narrativos)
# ============================================================
.demiurgos-estado.*
.demiurgos-estado*
.demiurgos-sync/
.env.backup

# ============================================================
# Python
# ============================================================
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ============================================================
# Build artifacts y temporales
# ============================================================
.tmp.driveupload/
output/
*.docx

# ============================================================
# SDD artifacts (persisten en Engram)
# ============================================================
sdd/
exploration.md

# ============================================================
# Live secrets export (leaked-history remediation, runbook #3559)
# ============================================================
engram-export.json

# ============================================================
# OpenCode legacy (no aplica a Hermes)
# ============================================================
src/opencode.json
src/tui.json
src/tui-plugins/
.migration-baseline.txt
src/tools/sync-ideas.py.bak-*
src/tools/gas-webhook.js
src/tools/pipedream-image-webhook.md
src/tools/set-webhook.ps1

# ============================================================
# OS junk
# ============================================================
Thumbs.db
.DS_Store

testsprite_tests\tmp\config.json

# ============================================================
# Wiki Frontend (React SPA)
# ============================================================
frontend/node_modules/
frontend/dist/

# ============================================================
# Datos runtime locales (SQLite / estado) — no se versionan
# ============================================================
data/*.sqlite3
data/*.sqlite3-*
data/*.lock
data/local-state.json
data/sessions.json
# Artefacto temporal que deja el sincronizador (filesystem de fusión)
data/.fuse_hidden*

# ============================================================
# Logs del launcher (S2-6: <install_root>/logs). En dev el install root es la
# raíz del repo, así que correr el launcher deja logs/ ahí. Es runtime, no se
# versiona (y no debe ensuciar `git status`).
# ============================================================
/logs/

# ============================================================
# Banco global de ideas (ideas/) — contenido narrativo del Autor,
# generado por capturas de Telegram/Asistente. Es dato de usuario,
# NO código: no se versiona.
# ============================================================
ideas/

# ============================================================
# OpenCode Telegram bridge — tooling personal del Autor para
# programar desde el celular. NO forma parte de Demiurgos:
# vive solo en local (fuera del repo).
# ============================================================
src/tools/opencode-bridge.py
src/tools/opencode-bridge.log
start-opencode-bridge.ps1
start-opencode-serve.ps1
# Local AI runtime state
.atl/
data/import-spool/
data/world-trash/

# ============================================================
# Metodología — store runtime y cuarentena (los seeds SÍ se versionan:
# data/methodology/seeds/ queda trackeado)
# ============================================================
data/methodology/library.json
data/methodology/quarantine/

# Carriers aportados por el Autor: dato runtime, no código. Se crean de
# forma perezosa en materialize/trust; nunca se versionan (el directorio
# seeds/ sigue siendo la autoridad de bytes de los skills bundled).
data/methodology/attachments/

# Staging de uploads por sesión (canvas → materialize): efímero, ligado al
# principal de la sesión; se limpia con sweep y nunca se versiona.
data/methodology/staging/

# Directorio de skills propiedad de Demiurgos (demiurgos-skills-directory):
# el contenido runtime generado bajo data/methodology/skills/ nunca se
# versiona; la carpeta vacía se conserva vía .gitkeep (trackeado). Los seeds
# (data/methodology/seeds/) siguen versionándose.
data/methodology/skills/*
!data/methodology/skills/.gitkeep

# Artefactos locales de herramientas y respaldos de configuración: son de esta
# máquina, no del proyecto. Nunca se versionan.
.impeccable/
config/backup.json

# Agent memory export — must never be tracked (leaked-secrets remediation)
engram-export.json
