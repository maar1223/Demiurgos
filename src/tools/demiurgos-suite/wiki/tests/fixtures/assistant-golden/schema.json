{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:demiurgos:assistant-golden:cases:v1",
  "title": "Assistant golden-set cases document",
  "description": "Validates a cases.yaml document. Validate a world.yaml against $defs.worldDescriptor.",
  "type": "object",
  "required": ["world", "cases"],
  "additionalProperties": false,
  "properties": {
    "world": { "$ref": "#/$defs/slug" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)?$"
    },
    "case": {
      "type": "object",
      "required": ["id", "level", "question", "source_paths", "expected_facts", "must_not"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "level": { "enum": ["C"] },
        "question": { "type": "string", "minLength": 1 },
        "language": { "$ref": "#/$defs/language" },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_facts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/factGroup" }
        },
        "must_not": {
          "type": "object",
          "required": ["codes"],
          "additionalProperties": false,
          "properties": {
            "codes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/mustNotCode" }
            },
            "strings": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "factGroup": {
      "type": "object",
      "required": ["name", "any_of"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "any_of": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mustNotCode": {
      "enum": [
        "invented_canon",
        "claimed_authority",
        "blind_answer",
        "uncited_source",
        "wrong_language",
        "wrong_tone"
      ]
    },
    "worldDescriptor": {
      "type": "object",
      "required": ["name", "description", "source"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "description": { "type": "string", "minLength": 1 },
        "source": { "enum": ["fixture", "data-root"] },
        "language": { "$ref": "#/$defs/language" }
      }
    }
  }
}
