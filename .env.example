# ============================================================
# Demiurgos — Provider Configuration Template
# ============================================================
# Copy this file to .env and uncomment the variables you need.
# Every Demiurgos component reads from the same convention.

# --- World ---
DEMIURGOS_WORLD=mi-mundo
DEMIURGOS_LANGUAGE=es

# --- Editing authentication ---
# Disabled by default. Set to local-dev only for loopback development testing.
# Set to credentials for the local account vault login (password + recovery
# words, fully offline).
# DEMIURGOS_AUTH_MODE=credentials
# The session cookie Secure flag is scheme-aware by default: HTTPS requests
# get a Secure cookie, plain HTTP (http://localhost or a VPS over HTTP) does
# not — the login works on any platform without configuration. Override
# explicitly only for special cases (e.g. TLS-terminating reverse proxy).
# DEMIURGOS_COOKIE_SECURE=
# Soft re-auth reminder interval in days (default 14): dismissible banner once
# elapsed + countdown always visible on the welcome card.
# DEMIURGOS_REAUTH_INTERVAL_D=14
# Session TTL: default 8 hours; opt-in "remember me" extends to 30 days.
# DEMIURGOS_SESSION_TTL_H=8
# DEMIURGOS_REMEMBER_ME_TTL_D=30

# --- Text LLM ---
DEMIURGOS_TEXT_PROVIDER=opencode-go
DEMIURGOS_TEXT_ENDPOINT=https://opencode.ai/zen/go/v1
DEMIURGOS_TEXT_MODEL=deepseek-v4-flash
# DEMIURGOS_TEXT_TIMEOUT=120
# DEMIURGOS_TEXT_API_KEY_ENV=OPENCODE_GO_API_KEY

# --- Vision LLM ---
DEMIURGOS_VISION_PROVIDER=opencode-go
DEMIURGOS_VISION_ENDPOINT=https://opencode.ai/zen/go/v1
DEMIURGOS_VISION_MODEL=qwen3.6-plus
# DEMIURGOS_VISION_TIMEOUT=120
# DEMIURGOS_VISION_API_KEY_ENV=OPENCODE_GO_API_KEY

# ============================================================
# Backup destination (opcional)
# ============================================================
# The destination is a local synced folder chosen in the app; the sync client
# is external and the operator's choice (e.g. abraunegg/onedrive on Linux).
# Demiurgos writes to the folder only — it never uploads or syncs.

# ============================================================
# Ideas Sync (Telegram + Google Sheets — opcional)
# ============================================================
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# TELEGRAM_BOT_TOKEN=

# ============================================================
# Google AI (Gemini — para imágenes con Nano Banana)
# ============================================================
# GOOGLE_API_KEY=
