# ============================================================
# Demiurgos — Provider Configuration Template
# ============================================================
# Copy this file to .env and uncomment the variables you need.
# Every Demiurgos component reads from the same convention.

# --- World ---
DEMIURGOS_WORLD=mi-mundo
DEMIURGOS_LANGUAGE=es

# --- Text LLM ---
DEMIURGOS_TEXT_PROVIDER=qwen
DEMIURGOS_TEXT_ENDPOINT=https://opencode.ai/zen/go/v1
DEMIURGOS_TEXT_MODEL=deepseek-v4-flash
# DEMIURGOS_TEXT_TIMEOUT=120
# DEMIURGOS_TEXT_API_KEY_ENV=OPENCODE_GO_API_KEY

# --- Vision LLM ---
DEMIURGOS_VISION_PROVIDER=qwen
DEMIURGOS_VISION_ENDPOINT=https://opencode.ai/zen/go/v1
DEMIURGOS_VISION_MODEL=qwen3.6-plus
# DEMIURGOS_VISION_TIMEOUT=120
# DEMIURGOS_VISION_API_KEY_ENV=OPENCODE_GO_API_KEY

# ============================================================
# Google Drive Sync (rclone — opcional)
# ============================================================
# RCLONE_CONFIG=default

# ============================================================
# Ideas Sync (Telegram + Google Sheets — opcional)
# ============================================================
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# TELEGRAM_BOT_TOKEN=

# ============================================================
# Google AI (Gemini — para imágenes con Nano Banana)
# ============================================================
# GOOGLE_API_KEY=
