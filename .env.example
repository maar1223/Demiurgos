# ============================================================
# Demiurgos — Configuración del mundo narrativo
# ============================================================
# Copiá este archivo a .env y completalo con tus datos

# Nombre del mundo activo (directorio bajo mundos/)
DEMIURGOS_WORLD=mi-mundo

# Idioma del proyecto (código ISO)
# en, zh, hi, es, es-ar, es-es, fr, ar, bn, pt, pt-br, ru, ur
DEMIURGOS_LANGUAGE=es

# ============================================================
# Google Drive Sync (rclone — opcional)
# ============================================================
# Descomentá para usar un perfil rclone específico
# RCLONE_CONFIG=default

# ============================================================
# Sync de Ideas (Google Sheets + Telegram — opcional)
# ============================================================
# Google Sheets spreadsheet ID (de la URL de la planilla)
# GOOGLE_SHEETS_ID=

# Ruta al archivo JSON de service account de Google Cloud
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Token del bot de Telegram (para recibir ideas por audio/texto)
# TELEGRAM_BOT_TOKEN=

# ============================================================
# Qwen Vision (análisis de imágenes para referencias — opcional)
# ============================================================
# QWEN_ENDPOINT=
# QWEN_MODEL=
# QWEN_API_KEY=

# ============================================================
# Google AI (Gemini — para imágenes con Nano Banana)
# ============================================================
# GOOGLE_API_KEY=
